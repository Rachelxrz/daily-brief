  "spec": {
    "版本": "2026-08-07",
    "说明": "Watchlist 系统规则(进入/分档/移出/回归/复检频率)。规则随数据走,改规则请同步更新此节。",
    "构成": {
      "core_holdings": "战略锚仓 GLD/QQQ/TLT/WTI(手动,豁免所有闸门)",
      "long_term": "手动加入的个股(标记:自选)",
      "screener_signals": "强势股筛选自动入选(标记:筛选)",
      "congress_signals": "国会交易信号",
      "suspended": "Secondary Watchlist(被移出,停买卖信号)",
      "classification": "每只股票的基本面分档属性"
    },
    "进入watchlist": {
      "手动": "加入 long_term",
      "强势股筛选": {
        "板块来源": "资金流入板块(相对大盘3月强弱 RS≥0)",
        "硬条件": [
          "市值 > 2亿美元",
          "周线价格 > 120周MA",
          "近3季净利润 增加或持平"
        ],
        "选取": "每板块按 6个月波动率 从小到大 取前3",
        "两档": "现有强势股(+日线20>50>150多头排列) / 潜在强势股(仅基本面)",
        "常驻": "入选即常驻,仅跌破周线150MA才移出(不再30天过期)"
      }
    },
    "分档定义_纯基本面": {
      "题材投机": "当前亏损 或 上市 < 3年",
      "成长性核心": "市值≥$50B 且 上市≥8年 且 近3年逐年净利润为正 且 最新利润 > 3年前",
      "稳定核心": "同核心 但利润未超3年前(持平/下滑) 且 年化波动 ≤ 45%",
      "趋势成长": "有盈利但够不到核心(有亏损年 / 市值或年限不够 / 利润不增且波动>45%,如TSLA)",
      "ETF/基金": "不适用个股分档",
      "备注": "回撤/波动/Beta 不参与定档,只作交易层特性(决定仓位/止损)"
    },
    "移出到Secondary": {
      "周线跌破150MA": "任何个股(core_holdings 豁免)",
      "3年回报低于QQQ": "稳定核心 近3年年化 < QQQ → 不如直接持有QQQ"
    },
    "回归主watchlist": {
      "周线跌破150MA": "周线价格 > 150MA 且 > 20MA 且 近2季净利润>0并上升",
      "3年回报低于QQQ": "近3年年化 重新 ≥ QQQ"
    },
    "复检频率": {
      "强势股筛选入选": "每交易日盘后",
      "均线买卖信号(活跃标的)": "每交易日盘后",
      "跌破150MA移出": "每交易日(daily_brief)",
      "150MA回归复查": "每周六",
      "分档+QQQ闸门复查": "每半年(1月1日 / 7月1日)"
    }
  }
}